/// <summary>
/// Reverse all words in the sentence eg.. I am a developer => developer a am I
/// </summary>
public class ReverseSentenceTest
{
    public string ReverseSentence(string sentence)
    {
        var splitSentence = sentence.Split(' ');
        var reverseSentenseArray = splitSentence.Reverse();
        var reverse = string.Join(' ', reverseSentenseArray);
        return reverse;
        // foreach(var word in reverseSentense)
        // {
        //   Console.WriteLine(word);
        // }
    }

    public void ShouldReverseSentence()
    {
        Assert.Equal("developer a am I", this.ReverseSentence("I am a developer"));
    }
}

