    }

    public class TraderData
    {
        public int TraderId { get; set; }
        public string Name { get; set; }
    }

    public class TraderTotal
    {
        public string Name { get; set; }
        public int Total { get; set; }
    }


    private IList<TradeData> tradesData;

    private IList<TraderData> tradersData;

    public TradeDataAnalysisTest()
    {
        this.tradesData = new List<TradeData>()
        {
            new TradeData { TraderId = 1, Value = -100, Date = DateTime.Parse("2016-06-01")},
            new TradeData { TraderId = 1, Value = 50, Date = DateTime.Parse("2016-06-01")},
            new TradeData { TraderId = 1, Value = 50, Date = DateTime.Parse("2016-06-02")},
            new TradeData { TraderId = 1, Value = 50, Date = DateTime.Parse("2016-06-02")},
            new TradeData { TraderId = 2, Value = 50, Date = DateTime.Parse("2016-06-02")}
