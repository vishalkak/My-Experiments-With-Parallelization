        this.tradersData = new List<TraderData>
        {
            new TraderData {TraderId = 1, Name = "Rob"},
            new TraderData
            {
                TraderId = 2,
                Name = "John"
            }
        };
    }

    public int calculateTradeTotal(IList<TradeData> tradesData)
    {
		    return tradesData.Sum(t => t.Value);
    }

    public IList<TraderTotal> calculateTradersTotal(IList<TradeData> tradesData, IList<TraderData> tradersData)
    {
		    var tradersTotal = tradersData
          .Join(tradesData, x => x.TraderId, y=> y.TraderId, (trader, trade) => new TraderTotal
          {
            Name = trader.Name,
            Total = trade.Value
          })
          .GroupBy(x => x.Name)
          .Select( g => new TraderTotal
          {
            Name = g.Key,
            Total = g.Sum(x => x.Total)
          }).ToList();
        
        return tradersTotal;

