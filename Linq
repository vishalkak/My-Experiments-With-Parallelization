class Assert
{
  public static void Equal(string a, string b)
  {
    if(!string.Equals(a, b, StringComparison.OrdinalIgnoreCase))
      throw new Exception($"Expected: {a} || Actual: {b}");
  }

  public static void Equal(int a, int b)
  {
    if(a != b)
      throw new Exception($"Expected: {a} || Actual: {b}");
  }
