    public void ShouldCalculateTradeTotal()
    {
        // Should calculate the total trades value
        Assert.Equal(100, this.calculateTradeTotal(this.tradesData));
    }

    public void ShouldCalculateTradersTotal()
    {
        // Should calculate total trade value per user
        var result = this.calculateTradersTotal(this.tradesData, this.tradersData);

        Assert.Equal("Rob", result[0].Name);
        Assert.Equal(50, result[0].Total);

