    private static void PrintSnapshot(Snapshot snapshot)
    {
        // Keep multi-line output together
        lock (_consoleLock)
        {
            Console.WriteLine(snapshot.Header);
            foreach (var r in snapshot.Rows)
            {
                if (r.Price.HasValue)
                    Console.WriteLine($"{r.Symbol} | {r.Quantity} | {r.Price.Value} | {r.Value!.Value}");
                else
                    Console.WriteLine($"{r.Symbol} | {r.Quantity} | N/A | N/A");
            }
            Console.WriteLine("-------------------------------------------------");
        }
    }

    private sealed record Snapshot(string Header, List<Row> Rows);
    private sealed record Row(string Symbol, int Quantity, decimal? Price, decimal? Value);
}
